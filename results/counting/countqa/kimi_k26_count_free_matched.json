 "protocol": {
  "training": "none on CountQA: saved FSC-147 heads and PCA are applied frozen",
  "frame": "letterbox (counting.letterbox_frame), whole image, fill counting.LETTERBOX_FILL",
  "transfer_preprocessing": "CountQA answers refer to the whole image, so each kept image is placed whole on a max(w, h) square canvas (counting.letterbox_frame, integer centring offsets) filled with counting.LETTERBOX_FILL and saved as PNG at native resolution; the adapter then resizes that square to the benchmark resolution. FSC-147 heads were trained on the central min-side square (counting.centre_crop_frame), so CountQA adds padding the heads never saw and a different object scale; predicted density is summed only over the valid (non-padding) area, counting.masked_count(density, counting.coverage(frame.valid, 64)). Exemplar boxes are mapped with frame.boxes, never centre-cropped.",
  "count": "counting.masked_count(density, counting.coverage(frame.valid, 64))",
  "prototype_valid": "counting.token_valid(frame.valid, side, grid_extent) at the token grid",
  "exemplars": "none",
  "exact_match": "floor(pred + 0.5) == integer answer",
  "bins": "counting.count_bin of the true answer",
  "rmse": "mean over seeds of each seed's sqrt(mean sq_error); rmse_pooled pools seed x image rows",
  "numerics": "readouts trained with cuDNN TF32 convolutions on GPU; this run's device may differ, so transfer parity with training is approximate at float32 rounding",
  "seeds": [
   0,
   1,
   2
  ],
  "bootstrap": {
   "function": "vtb.geometry_bootstrap.paired_metric_bootstrap",
   "pairing": "identical image IDs; seed k with seed k; per-image seed-mean metric",
   "resamples": 10000,
   "confidence": 0.95,
   "interval": "percentile",
   "bootstrap_seed": 0,
   "abs_error_difference": "second_minus_first (positive: first has lower error)",
   "exact_match_difference": "first_minus_second"
  }
 },
